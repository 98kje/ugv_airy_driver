<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_airy_driver</name>
  <version>0.1.0</version>
  <description>RoboSense Airy (rslidar_sdk) to Autoware sensing pipeline for ugv_a</description>
  <maintainer email="bak1916@gmail.com">jekim98</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>autoware_point_types</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>autoware_pointcloud_preprocessor</exec_depend>
  <exec_depend>common_sensor_launch</exec_depend>
  <exec_depend>rslidar_sdk</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
